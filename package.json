{
  "name": "earshot-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Earshot: screen a brand name across 25 languages with the check_name tool.",
  "license": "MIT",
  "mcpName": "io.github.moshejs/earshot",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "brand-name",
    "naming",
    "linguistic-check",
    "localization"
  ],
  "homepage": "https://earshot.quentin.software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshejs/earshot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/moshejs/earshot-mcp/issues"
  },
  "author": "Moshe Malka",
